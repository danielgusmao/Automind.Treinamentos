@model List<PendingUserViewModel>
@{
    var training = (Training)ViewBag.Training;
    var schedule = ViewBag.TeamsSchedule as TrainingReminderSchedule ?? new TrainingReminderSchedule { TrainingId = training.Id, IntervalDays = 15 };
    ViewData["Title"] = "Pendentes";
    var pending = Model.Count(x => !x.Completed);
    var completed = Model.Count - pending;
    var excludedCount = ViewBag.ExcludedCount is int count ? count : 0;
    var teamsConfigured = ViewBag.TeamsConfigured is bool value && value;
}
<div class="page-head"><div><span class="eyebrow">ACTIVE DIRECTORY</span><h1>Pendências do treinamento</h1><p>@training.Title</p></div><div class="page-head-actions"><a class="btn secondary" asp-action="DirectoryExclusions">Exclusões permanentes</a><a class="btn secondary" asp-action="Index">Voltar</a></div></div>
<div class="stats stats-five"><div class="stat"><strong>@Model.Count</strong><span>Elegíveis</span></div><div class="stat"><strong>@completed</strong><span>Concluídos</span></div><div class="stat"><strong>@pending</strong><span>Pendentes</span></div><div class="stat"><strong>@excludedCount</strong><span>Excluídos permanentes</span></div><div class="stat"><strong>@(Model.Count == 0 ? 0 : Math.Round((double)completed / Model.Count * 100, 1))%</strong><span>Adesão</span></div></div>
@if(ViewBag.AdError is not null){<div class="alert error">Falha ao consultar o AD: @ViewBag.AdError</div>}
@if(TempData["TeamsResult"] is string result){<div class="alert success">@result</div>}
@if(TempData["TeamsError"] is string teamsError){<div class="alert error">@teamsError</div>}
@if(TempData["TeamsScheduleResult"] is string scheduleResult){<div class="alert success">@scheduleResult</div>}
@if(TempData["TeamsScheduleError"] is string scheduleError){<div class="alert error">@scheduleError</div>}
@if(TempData["ExclusionResult"] is string exclusionResult){<div class="alert success">@exclusionResult</div>}
@if(TempData["ExclusionError"] is string exclusionError){<div class="alert error">@exclusionError</div>}
@if(!teamsConfigured){<div class="alert info"><strong>Teams:</strong> o Workflow precisa estar configurado no ambiente para habilitar envios e agenda.</div>}

<div class="card reminder-schedule-card">
    <div class="reminder-schedule-head">
        <div>
            <span class="eyebrow">AGENDA TEAMS</span>
            <h2>Lembretes automáticos</h2>
            <p class="muted">Quem ainda não concluiu pode receber novo aviso depois do intervalo definido. Um envio confirmado recente também conta para o intervalo.</p>
        </div>
        <div class="reminder-schedule-summary">
            <span class="status @(schedule.Enabled ? "done" : "draft")">@(schedule.Enabled ? "Agenda ativa" : "Agenda desativada")</span>
            <span class="reminder-next-run">
                Próxima execução:
                @if(schedule.Enabled && schedule.NextRunAtUtc is DateTime nextRun){<time class="local-datetime" data-utc="@nextRun.ToString("O")">@nextRun.ToString("dd/MM/yyyy HH:mm") UTC</time>}else{<strong>-</strong>}
            </span>
        </div>
    </div>
    <form asp-action="SaveTeamsReminderSchedule" method="post" class="reminder-schedule-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="trainingId" value="@training.Id" />
        <label class="reminder-toggle"><input type="checkbox" name="enabled" value="true" checked="@(schedule.Enabled ? "checked" : null)" /> Ativar lembretes automáticos</label>
        <label class="reminder-interval">Periodicidade <span class="muted">(dias)</span><input type="number" name="intervalDays" min="1" max="365" value="@schedule.IntervalDays" required /></label>
        <button class="btn secondary" type="submit" disabled="@(!teamsConfigured)">Salvar agenda</button>
    </form>
</div>

<div class="card pending-card">
    <div class="pending-toolbar">
        <div><span class="eyebrow">LEMBRETES</span><h2>Colaboradores elegíveis</h2><p class="muted">O status do Teams passa a ser registrado a partir desta versão. Para seleção manual, considera-se o intervalo atual de @schedule.IntervalDays dia(s).</p></div>
        <div class="pending-toolbar-actions">
            <button class="btn secondary" type="button" id="markDuePending" disabled="@(pending==0)">Marcar quem precisa de aviso</button>
            <button class="btn secondary" type="button" id="toggleAllPending" disabled="@(pending==0)">Marcar todos os pendentes</button>
            <form id="batchReminderForm" asp-action="SendTeamsReminders" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="trainingId" value="@training.Id" />
                <button class="btn primary" type="submit" disabled="@(!teamsConfigured || pending==0)">Enviar Teams aos selecionados</button>
            </form>
        </div>
    </div>
    <div class="admin-table-shell pending-table-shell">
        <table class="pending-reminder-table">
            <thead><tr><th class="select-col">Marcar</th><th>Status</th><th>Nome</th><th class="col-login">Login</th><th class="col-email">E-mail</th><th>Teams</th><th>Enviado em</th><th class="col-job">Cargo</th><th class="col-department">Departamento</th><th class="action-col">Ação</th></tr></thead>
            <tbody>
            @foreach(var x in Model.OrderBy(x=>x.Completed).ThenByDescending(x=>x.ReminderDue).ThenBy(x=>x.User.DisplayName)){
                var last = x.LastTeamsReminder;
                var lastSent = x.LastSuccessfulTeamsReminder;
                var isSending = last is not null && (last.Status == TeamsReminderStatus.Queued || last.Status == TeamsReminderStatus.Processing);
                var teamsLabel = lastSent is not null ? "Enviado" : last?.Status == TeamsReminderStatus.Failed ? "Falhou" : isSending ? "Enviando" : "Não enviado";
                var teamsCss = lastSent is not null ? "teams-sent" : last?.Status == TeamsReminderStatus.Failed ? "teams-failed" : isSending ? "teams-processing" : "teams-none";
                var sentAt = lastSent?.FinishedAtUtc ?? lastSent?.AttemptedAtUtc;
                <tr class="@(x.Completed?"row-completed":"")">
                    <td class="select-col" data-label="Marcar">@if(!x.Completed){<input class="pending-check" type="checkbox" name="selectedSams" value="@x.User.SamAccountName" form="batchReminderForm" data-reminder-due="@(x.ReminderDue ? "true" : "false")" aria-label="Selecionar @x.User.DisplayName" />}</td>
                    <td data-label="Status"><span class="status @(x.Completed?"done":"pending")">@(x.Completed?"Concluído":"Pendente")</span></td>
                    <td data-label="Nome"><strong>@x.User.DisplayName</strong></td>
                    <td class="col-login" data-label="Login">@x.User.SamAccountName</td>
                    <td class="col-email" data-label="E-mail">@x.User.Email</td>
                    <td data-label="Teams"><span class="status @teamsCss" title="@(last?.Error ?? string.Empty)">@teamsLabel</span></td>
                    <td data-label="Enviado em">
                        @if(sentAt is DateTime sentDate){<time class="local-datetime reminder-time" data-utc="@sentDate.ToString("O")">@sentDate.ToString("dd/MM/yyyy HH:mm") UTC</time>}else{<span class="muted">-</span>}
                    </td>
                    <td class="col-job" data-label="Cargo">@x.User.JobTitle</td>
                    <td class="col-department" data-label="Departamento">@x.User.Department</td>
                    <td class="action-col" data-label="Ação">
                        @if(!x.Completed){
                            <div class="row-actions">
                                <form asp-action="SendTeamsReminders" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="trainingId" value="@training.Id"/><input type="hidden" name="selectedSams" value="@x.User.SamAccountName"/><button class="btn secondary btn-small" type="submit" disabled="@(!teamsConfigured || isSending)">@(isSending ? "Aguardando Teams" : lastSent is null ? "Enviar Teams" : "Reenviar Teams")</button></form>
                                <button class="btn danger btn-small exclude-user-btn" type="button" data-sam="@x.User.SamAccountName" data-name="@x.User.DisplayName" data-email="@x.User.Email">Excluir permanentemente</button>
                            </div>
                        }else{<span class="muted">Concluído</span>}
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-backdrop" id="excludeModal" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="excludeTitle">
        <div class="modal-head"><div><span class="eyebrow">LISTA PERMANENTE</span><h2 id="excludeTitle">Excluir da base de treinamentos</h2></div><button type="button" class="modal-close" id="closeExcludeModal" aria-label="Fechar">×</button></div>
        <div class="alert info"><strong>Atenção:</strong> esta exclusão vale para todos os treinamentos atuais e futuros. A conta continuará existindo no Active Directory.</div>
        <form asp-action="ExcludeUser" method="post" class="form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" name="trainingId" value="@training.Id"/>
            <input type="hidden" name="sam" id="excludeSam"/>
            <div class="exclusion-person" id="excludePerson"></div>
            <label for="excludeCategory">Tipo de conta</label>
            <select id="excludeCategory" name="category" required>
                <option>E-mail geral / Caixa compartilhada</option>
                <option>Conta de serviço</option>
                <option>Terceiro / Não colaborador</option>
                <option>Outro</option>
            </select>
            <label for="excludeReason">Motivo</label>
            <input id="excludeReason" name="reason" maxlength="300" required placeholder="Ex.: e-mail geral da área, não representa uma pessoa..."/>
            <div class="modal-actions"><button class="btn secondary" type="button" id="cancelExcludeModal">Cancelar</button><button class="btn danger" type="submit">Adicionar à lista permanente</button></div>
        </form>
    </div>
</div>

@section Scripts{
<script>
(() => {
    const button = document.getElementById('toggleAllPending');
    if (button) {
        button.addEventListener('click', () => {
            const boxes = [...document.querySelectorAll('.pending-check')];
            if (!boxes.length) return;
            const mark = boxes.some(x => !x.checked);
            boxes.forEach(x => x.checked = mark);
            button.textContent = mark ? 'Desmarcar todos' : 'Marcar todos os pendentes';
        });
    }

    document.getElementById('markDuePending')?.addEventListener('click', () => {
        document.querySelectorAll('.pending-check').forEach(box => {
            box.checked = box.dataset.reminderDue === 'true';
        });
    });

    document.querySelectorAll('.local-datetime').forEach(el => {
        const raw = el.dataset.utc;
        if (!raw) return;
        const date = new Date(raw);
        if (Number.isNaN(date.getTime())) return;
        el.textContent = date.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
    });

    const modal = document.getElementById('excludeModal');
    const sam = document.getElementById('excludeSam');
    const person = document.getElementById('excludePerson');
    const reason = document.getElementById('excludeReason');
    const close = () => { if (modal) modal.hidden = true; };
    document.querySelectorAll('.exclude-user-btn').forEach(btn => btn.addEventListener('click', () => {
        if (!modal || !sam || !person || !reason) return;
        sam.value = btn.dataset.sam || '';
        person.textContent = `${btn.dataset.name || ''} · ${btn.dataset.email || ''} · ${btn.dataset.sam || ''}`;
        reason.value = '';
        modal.hidden = false;
        setTimeout(() => reason.focus(), 0);
    }));
    document.getElementById('closeExcludeModal')?.addEventListener('click', close);
    document.getElementById('cancelExcludeModal')?.addEventListener('click', close);
    modal?.addEventListener('click', e => { if (e.target === modal) close(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
})();
</script>
}
