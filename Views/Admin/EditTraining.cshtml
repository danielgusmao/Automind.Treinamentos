@model AdminTrainingEditViewModel
@{ ViewData["Title"] = "Editar treinamento"; }
<div class="page-head">
    <div>
        <span class="eyebrow">ADMINISTRAÇÃO</span>
        <h1>Editar treinamento</h1>
        <p>@Model.Code · versão atual @Model.CurrentVersion</p>
    </div>
    <a class="btn secondary" asp-action="Trainings">Voltar ao catálogo</a>
</div>

@if (Model.HasCompletions || Model.IsArchived)
{
    <div class="alert warning">
        <strong>Versão protegida por evidências.</strong>
        Existem @Model.CompletionCount registros de conclusão vinculados à versão @Model.CurrentVersion.
        Ao salvar, a versão atual não será alterada: o sistema criará uma <strong>nova versão em rascunho</strong> e copiará todas as questões.
    </div>
}
else
{
    <div class="alert success">
        Esta versão ainda não possui evidências. As alterações podem ser salvas diretamente nela.
    </div>
}

@if (Model.LayoutKey == "security-awareness-v1")
{
    <div class="alert warning">
        Este treinamento usa o layout visual dedicado de Segurança da Informação. Título, descrição, resumo do PDF, versão, tempo e nota podem ser alterados aqui. Os módulos visuais permanecem controlados pelo layout dedicado.
    </div>
}

<form asp-action="EditTraining" method="post" class="card form-grid">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="CurrentVersion" type="hidden" />
    <input asp-for="LayoutKey" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert error span2"></div>

    <label>Código
        <input asp-for="Code" readonly />
        <span class="form-help">Identificador permanente da família do treinamento.</span>
    </label>
    <label>Slug
        <input asp-for="Slug" readonly />
        <span class="form-help">Identificador técnico. Não é alterado depois da criação.</span>
    </label>

    <label class="span2">Título<input asp-for="Title" /></label>
    <label class="span2">Descrição<textarea asp-for="Description" rows="2"></textarea></label>
    <label class="span2">Resumo para o PDF<textarea asp-for="SummaryText" rows="4"></textarea><span class="form-help">Resumo que aparece na segunda página da evidência PDF.</span></label>

    <label>Versão
        <input asp-for="Version" />
        @if (Model.HasCompletions || Model.IsArchived)
        {
            <span class="form-help">Obrigatoriamente diferente de @Model.CurrentVersion. Sugestão preenchida automaticamente.</span>
        }
    </label>
    <label>Tempo estimado (minutos)<input asp-for="EstimatedMinutes" type="number" min="1" max="480" /></label>
    <label>Nota mínima<input asp-for="PassingScore" type="number" min="1" /></label>

    @if (Model.LayoutKey != "security-awareness-v1")
    {
        <label class="span2">Conteúdo<textarea asp-for="ContentText" rows="22"></textarea></label>
    }
    else
    {
        <input asp-for="ContentText" type="hidden" />
    }

    <label class="checkline"><input asp-for="RequiredForAll" /> Obrigatório para todos os usuários elegíveis do AD</label>

    <div class="span2 form-actions">
        <button class="btn primary" type="submit">@(Model.HasCompletions || Model.IsArchived ? "Criar nova versão" : "Salvar alterações")</button>
        <a class="btn secondary" asp-action="Questions" asp-route-id="@Model.Id">Questões</a>
    </div>
</form>
