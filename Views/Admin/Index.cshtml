@model List<Training>
@{
    ViewData["Title"] = "Administracao";
}
<section class="dashboard-hero">
    <div class="dashboard-hero-copy">
        <span class="eyebrow eyebrow-light">ADMINISTRAÇÃO</span>
        <h1>Gestao de treinamentos</h1>
        <p>Publique conteudos, acompanhe adesao, identifique pendencias no Active Directory e gere evidencias consolidadas.</p>
        <div class="hero-pills"><span class="hero-pill">Acesso administrativo</span><span class="hero-pill">Base oficial SQLite + AD</span></div>
    </div>
    <div class="hero-symbol"><img src="~/images/automind-symbol.png" alt="" /></div>
</section>
<div class="page-head"><div><span class="eyebrow">VISAO GERAL</span><h1>Painel administrativo</h1><p>Indicadores atuais do portal.</p></div><div class="page-head-actions"><a class="btn secondary" asp-action="DirectoryExclusions">Exclusões permanentes</a><a class="btn primary" asp-action="CreateTraining">Novo treinamento</a></div></div>
<div class="stats stats-five">
    <div class="stat"><strong>@Model.Count</strong><span>Treinamentos</span><small>Total cadastrado</small></div>
    <div class="stat"><strong>@ViewBag.Published</strong><span>Publicados</span><small>Disponiveis aos colaboradores</small></div>
    <div class="stat"><strong>@ViewBag.Completions</strong><span>Conclusoes</span><small>Evidencias registradas</small></div>
    <div class="stat"><strong>@(ViewBag.EligibleAdUsers ?? "-")</strong><span>Pessoas elegiveis</span><small>AD menos exclusoes permanentes</small></div>
    <div class="stat"><strong>@ViewBag.DirectoryExclusions</strong><span>Exclusoes permanentes</span><small>Contas gerais/tecnicas ignoradas</small></div>
</div>
@if (ViewBag.AdError is not null) { <div class="alert error">Nao foi possivel consultar o AD: @ViewBag.AdError</div> }
<div class="card">
    <div class="page-head"><div><span class="eyebrow">CATALOGO</span><h1 style="font-size:1.45rem">Treinamentos</h1></div><a class="btn secondary" asp-action="Trainings">Ver catalogo completo</a></div>
    <div class="admin-table-shell"><table><thead><tr><th>Titulo</th><th>Versao</th><th>Tempo</th><th>Status</th><th>Acoes</th></tr></thead><tbody>
    @foreach (var t in Model)
    {
        <tr><td><strong>@t.Title</strong><br /><span class="muted">@t.Code</span></td><td>@t.Version</td><td>~ @t.EstimatedMinutes min</td><td><span class="status @(t.IsPublished ? "published" : "draft")">@(t.IsPublished ? "Publicado" : "Rascunho")</span></td><td><div class="table-actions"><a asp-action="Completions" asp-route-id="@t.Id">Concluidos</a><a asp-action="Pending" asp-route-id="@t.Id">Pendentes</a><a asp-action="Questions" asp-route-id="@t.Id">Questoes</a></div></td></tr>
    }
    </tbody></table></div>
</div>
