@model List<TrainingCompletion>
@{ var training=(Training)ViewBag.Training; ViewData["Title"]="Concluidos"; var avg = Model.Count == 0 ? 0 : (int)Math.Round(Model.Average(x => x.DurationSeconds)); var avgLabel = avg <= 0 ? "-" : TimeSpan.FromSeconds(avg).TotalHours >= 1 ? $"{(int)TimeSpan.FromSeconds(avg).TotalHours} h {TimeSpan.FromSeconds(avg).Minutes:D2} min" : $"{TimeSpan.FromSeconds(avg).Minutes} min {TimeSpan.FromSeconds(avg).Seconds:D2} s"; }
<div class="page-head"><div><span class="eyebrow">EVIDENCIAS</span><h1>Conclusoes registradas</h1><p>@training.Title</p></div><a class="btn primary" asp-action="ConsolidatedPdf" asp-route-id="@training.Id">Gerar PDF consolidado</a></div>
<div class="stats"><div class="stat"><strong>@Model.Count</strong><span>Conclusoes</span></div><div class="stat"><strong>@training.EstimatedMinutes min</strong><span>Tempo estimado</span></div><div class="stat"><strong style="font-size:1.35rem">@avgLabel</strong><span>Tempo medio realizado</span></div><div class="stat"><strong>@training.Version</strong><span>Versao</span></div></div>
<div class="card"><div class="admin-table-shell"><table><thead><tr><th>Nome</th><th>Login</th><th>E-mail</th><th>Nota</th><th>Tempo</th><th>Data</th><th>Protocolo</th><th>PDF</th></tr></thead><tbody>
@foreach(var c in Model){<tr><td><strong>@c.DisplayName</strong></td><td>@c.SamAccountName</td><td>@c.Email</td><td><span class="status done">@c.Score/@c.Total</span></td><td>@c.DurationLabel</td><td>@c.AcceptedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@c.Protocol</td><td><a class="btn secondary" asp-action="Evidence" asp-route-trainingId="@training.Id" asp-route-sam="@c.SamAccountName">Abrir</a></td></tr>}
</tbody></table></div></div>
