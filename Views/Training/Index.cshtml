@model List<TrainingListItemViewModel>
@{
    ViewData["Title"] = "Meus treinamentos";
    var done = Model.Count(x => x.Completion is not null);
    var pending = Model.Count - done;
    var totalMinutes = Model.Where(x => x.Completion is null).Sum(x => x.Training.EstimatedMinutes);
}
@if(TempData["TrainingMessage"] is string trainingMessage){<div class="alert info">@trainingMessage</div>}
<section class="dashboard-hero">
    <div class="dashboard-hero-copy">
        <span class="eyebrow eyebrow-light">PORTAL DE CAPACITAÇÃO</span>
        <h1>Meus treinamentos</h1>
        <p>Acompanhe treinamentos obrigatórios, conclua os conteúdos e mantenha suas evidências disponíveis em PDF.</p>
        <div class="hero-pills">
            <span class="hero-pill">@pending pendente(s)</span>
            <span class="hero-pill">@done concluído(s)</span>
            <span class="hero-pill">@totalMinutes min estimados pendentes</span>
        </div>
    </div>
    <div class="hero-symbol"><img src="~/images/automind-symbol.png" alt="" /></div>
</section>
<div class="page-head training-list-head"><div><span class="eyebrow">CAPACITAÇÃO</span><h2>Treinamentos atribuídos</h2><p>Conteúdos disponíveis para o seu perfil.</p></div></div>
<div class="training-grid">
@foreach (var item in Model)
{
    <article class="card training-card">
        <div class="training-card-body">
            <div class="training-card-top">
                <span class="status @(item.Completion is null ? "pending" : "done")">@(item.Completion is null ? "PENDENTE" : "CONCLUÍDO")</span>
                <span class="meta-chip">@item.Training.Code</span>
            </div>
            <h2>@item.Training.Title</h2>
            <p>@item.Training.Description</p>
            <div class="training-meta">
                <span class="meta-chip">Versão @item.Training.Version</span>
                <span class="meta-chip">~ @item.Training.EstimatedMinutes min</span>
                <span class="meta-chip">Nota mínima @item.Training.PassingScore</span>
            </div>
            @if (item.Completion is null)
            {
                <div class="training-card-actions"><a class="btn primary" asp-action="Start" asp-route-id="@item.Training.Id">Iniciar treinamento</a></div>
            }
            else
            {
                <div class="done-info">Concluído em @item.Completion.AcceptedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br />Nota @item.Completion.Score/@item.Completion.Total &middot; Tempo @item.Completion.DurationLabel</div>
                <div class="training-card-actions"><a class="btn secondary" asp-action="Evidence" asp-route-trainingId="@item.Training.Id">Baixar comprovante</a></div>
            }
        </div>
    </article>
}
</div>
