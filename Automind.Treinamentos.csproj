<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Automind.Treinamentos</RootNamespace>
    <AssemblyName>Automind.Treinamentos</AssemblyName>
    <Version>0.0.23</Version>
    <FileVersion>0.0.23.0</FileVersion>
    <InformationalVersion>0.0.23</InformationalVersion>
  </PropertyGroup>


  <ItemGroup>
    <!-- Evita que fontes residuais de scaffolds/tests em workspaces reutilizados sejam compiladas pelo projeto web. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.12" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.12" />
  </ItemGroup>

  <!-- A versão do assembly e a fonte oficial exibida pela UI. -->
  <Target Name="WriteBuildVersionFile" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)VERSION.txt" Lines="v$(Version)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <Target Name="WritePublishVersionFile" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)VERSION.txt" Lines="v$(Version)" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
